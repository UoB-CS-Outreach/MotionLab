{
  "rules": {
    "motionlab": {
      "$session": {
        ".read": "$session.matches(/^[a-z2-7]{20}$/)",
        ".write": "$session.matches(/^[a-z2-7]{20}$/)",
        "toDesktop": {
          "$message": {
            ".validate": "newData.hasChildren(['m']) && newData.child('m').isString() && newData.child('m').val().length <= 16000",
            "m": {".validate": true},
            "$other": {".validate": false}
          }
        },
        "toPhone": {
          "$message": {
            ".validate": "newData.hasChildren(['m']) && newData.child('m').isString() && newData.child('m').val().length <= 16000",
            "m": {".validate": true},
            "$other": {".validate": false}
          }
        },
        "$other": {".validate": false}
      }
    }
  }
}
